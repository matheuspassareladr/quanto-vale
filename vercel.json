{
 "cleanUrls": true,
 "redirects": [
  {
   "source": "/app.",
   "destination": "/app",
   "permanent": false
  },
  {
   "source": "/app/",
   "destination": "/app",
   "permanent": false
  },
  {
   "source": "/mapa/",
   "destination": "/mapa",
   "permanent": false
  }
 ],
 "functions": {
  "api/avaliar.js": {
   "maxDuration": 60
  },
  "api/teste.js": {
   "maxDuration": 60
  },
  "api/mapa.js": {
   "maxDuration": 60
  }
 },
 "rewrites": [
  {
   "source": "/",
   "has": [
    {
     "type": "host",
     "value": "mapadaaprovacaobr.vercel.app"
    }
   ],
   "destination": "/mapa"
  },
  {
   "source": "/app",
   "has": [
    {
     "type": "host",
     "value": "mapadaaprovacaobr.vercel.app"
    }
   ],
   "destination": "/mapa/app"
  }
 ]
}